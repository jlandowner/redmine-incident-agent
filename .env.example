# Redmine
REDMINE_URL=https://redmine.example.internal
REDMINE_API_KEY=replace-me
REDMINE_AGENT_INSTRUCTION_PAGE=AgentInstruction
REDMINE_TAG_WRITE_FIELD=tag_list
REDMINE_NORMALIZED_TAG=agent:normalized
REDMINE_WATERMARK_PREFIX=agent:watermark=
REDMINE_HTTP_TIMEOUT=20

# Dispatcher
MAX_CONCURRENCY=4
PROJECT_LIMIT=100
ISSUE_LIMIT=100
SEARCH_LIMIT=10

# LLM: vLLM (recommended for the user's local setup)
LLM_PROVIDER=vllm
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_BASE_URL=http://vllm.default.svc:8000/v1
LLM_API_KEY=

# Alternative OpenAI-compatible endpoint
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=my-model
# LLM_BASE_URL=https://llm-gateway.example/v1
# LLM_API_KEY=replace-me
